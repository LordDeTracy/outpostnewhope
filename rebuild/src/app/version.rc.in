// The executable's version information (Properties > Details), filled in by
// CMake from OUTPOST_VERSION.
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
FILEVERSION @OUTPOST_VERSION_NUMBERS@
PRODUCTVERSION @OUTPOST_VERSION_NUMBERS@
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "LordDeTracy"
            VALUE "FileDescription", "Outpost: New Hope"
            VALUE "FileVersion", "@OUTPOST_VERSION@"
            VALUE "InternalName", "OutpostNewHope"
            VALUE "LegalCopyright", "Copyright (c) 2026 LordDeTracy, MIT licence"
            VALUE "OriginalFilename", "OutpostNewHope.exe"
            VALUE "ProductName", "Outpost: New Hope"
            VALUE "ProductVersion", "@OUTPOST_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
